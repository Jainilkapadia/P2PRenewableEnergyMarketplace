# Environment Configuration for Local Development & Demo
PROJECT_NAME="P2P Renewable Energy Trading Marketplace"
ENV="development"
DEBUG=True

# Backend
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-for-local-hackathon-development"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=p2p_energy_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/p2p_energy_db"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_DEFAULT_CITY="Ahmedabad, GJ"
NEXT_PUBLIC_DEFAULT_LAT=23.0225
NEXT_PUBLIC_DEFAULT_LNG=72.5714

